#!/usr/bin/env bash
#
# Pre-commit hook: run scripts/skill-review on every changed skill.
# Blocks the commit only when the review actually ran and found something.
# A review that could not run at all (no backend configured, network down)
# is a warning, not a block: infra trouble on your machine should never be
# the reason --no-verify starts feeling routine.
#
# The backends and their config live in scripts/skill-review; see SETUP.md.

set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1

TOOL="scripts/skill-review"

# Every skill in the repository, derived rather than listed. A hardcoded array
# goes stale the first time a skill is added and nobody notices, because the
# symptom is a skill silently not being reviewed. Skills live under skills/,
# which is where the plugin runtime looks for them; globbing */ here would
# match nothing and report success against an empty list.
SKILLS=()
for d in skills/*/; do
  d="${d%/}"
  [ -f "$d/SKILL.md" ] && SKILLS+=("$d")
done
if [ "${#SKILLS[@]}" -eq 0 ]; then exit 0; fi

STAGED=$(git diff --cached --name-only)

CHANGED_SKILLS=()
for skill in "${SKILLS[@]}"; do
  if echo "$STAGED" | grep -q "^$skill/"; then
    CHANGED_SKILLS+=("$skill")
  fi
done

if [ "${#CHANGED_SKILLS[@]}" -eq 0 ]; then
  exit 0
fi

if [ ! -x "$TOOL" ]; then
  echo "scripts/skill-review missing or not executable, skipping review"
  exit 0
fi

echo "Reviewing ${#CHANGED_SKILLS[@]} skill(s) before commit..."

FAILED=0
PASSED=0
SKIPPED=0
for skill in "${CHANGED_SKILLS[@]}"; do
  echo ""
  echo "Reviewing $skill..."

  if OUTPUT=$("$TOOL" "$skill" 2>&1); then
    echo "$OUTPUT"
    echo "$skill passed review"
    PASSED=$((PASSED + 1))
  else
    STATUS=$?
    echo "$OUTPUT"
    if [ "$STATUS" -eq 1 ]; then
      echo "$skill review failed"
      FAILED=$((FAILED + 1))
    else
      echo "review could not run for $skill, skipping (see SETUP.md)"
      SKIPPED=$((SKIPPED + 1))
    fi
  fi
done

if [ "$FAILED" -gt 0 ]; then
  echo ""
  echo "$FAILED skill(s) failed review. Fix the findings and commit again."
  echo "Override with: git commit --no-verify (not recommended)"
  exit 1
fi

echo ""
if [ "$PASSED" -gt 0 ]; then
  echo "$PASSED skill(s) passed review, $SKIPPED skipped."
else
  echo "No skill was actually reviewed ($SKIPPED skipped). See SETUP.md."
fi
exit 0
