#!/usr/bin/env bash
#
# Pre-commit hook: run scripts/skill-review on every skill with staged changes.
#
# Does nothing at all unless SKILL_REVIEW_BACKEND is set, in the environment or
# in .env.local. When it is set, a review that found something blocks the
# commit, and a review that could not run (timeout, network, credentials) warns
# and lets the commit through: trouble on your own machine should never be the
# reason --no-verify starts feeling routine.
#
# The backends and their config live in scripts/skill-review; see SETUP.md.

set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1

# Run through bash, the way pre-commit runs this hook, so nothing depends on
# the exec bit. Checking -x here turned a lost bit (a zip download, a clone
# with core.fileMode off) into a review that silently never ran.
TOOL="scripts/skill-review"
[ -f "$TOOL" ] || exit 0

# Opt-in, and silent when not opted into. Claude Code on your PATH or an API
# key in your shell is not a request for a blocking review.
bash "$TOOL" --configured || exit 0

# Every skill with a staged change, derived rather than listed: a hardcoded
# array goes stale the first time a skill is added, and the symptom is a skill
# silently not being reviewed. Skills live under skills/, where the plugin
# runtime looks for them.
#
# Ask git per skill rather than piping the whole staged list through grep.
# Under pipefail, `grep -q` exits at its first match and the writer takes
# SIGPIPE once the list outgrows the pipe buffer, which reads as "unchanged".
# `git diff --quiet` exits 1 when the path has staged changes.
CHANGED_SKILLS=()
for d in skills/*/; do
  d="${d%/}"
  [ -f "$d/SKILL.md" ] || continue
  git diff --cached --quiet -- "$d" || CHANGED_SKILLS+=("$d")
done

if [ "${#CHANGED_SKILLS[@]}" -eq 0 ]; then
  exit 0
fi

# Review what is about to be committed, not what happens to be on disk.
# scripts/validate-skills.sh already reads --from-index; the review did not,
# so with a partially staged file the model read text that was never going in.
# checkout-index writes the index content into a scratch tree, and the real
# path is passed through as a label so findings stay actionable.
SNAP=$(mktemp -d 2>/dev/null) || SNAP=""
if [ -n "$SNAP" ]; then
  trap 'rm -rf "$SNAP"' EXIT INT TERM
fi

snapshot_of() {
  # Echoes a directory holding the indexed copy of $1, or $1 itself if the
  # snapshot could not be made. Falling back to the working tree is worse than
  # the snapshot and better than not reviewing at all, but it is not what
  # SETUP.md promises, so it says so on stderr rather than happening quietly.
  local skill="$1"
  if [ -n "$SNAP" ] \
     && git ls-files -z -- "$skill" | xargs -0 git checkout-index --prefix="$SNAP/" -- 2>/dev/null \
     && [ -d "$SNAP/$skill" ]; then
    echo "$SNAP/$skill"
  else
    echo "warning: could not snapshot the staged copy of $skill, reviewing the working tree instead" >&2
    echo "$skill"
  fi
}

echo "Reviewing ${#CHANGED_SKILLS[@]} skill(s) before commit..."

FAILED=0
PASSED=0
SKIPPED=0
for skill in "${CHANGED_SKILLS[@]}"; do
  echo ""
  echo "Reviewing $skill..."

  REVIEW_DIR=$(snapshot_of "$skill")
  if OUTPUT=$(bash "$TOOL" "$REVIEW_DIR" "$skill" 2>&1); then
    echo "$OUTPUT"
    echo "$skill passed review"
    PASSED=$((PASSED + 1))
  else
    STATUS=$?
    echo "$OUTPUT"
    if [ "$STATUS" -eq 1 ]; then
      echo "$skill review failed"
      FAILED=$((FAILED + 1))
    else
      echo "review could not run for $skill, skipping (see SETUP.md)"
      SKIPPED=$((SKIPPED + 1))
    fi
  fi
done

if [ "$FAILED" -gt 0 ]; then
  echo ""
  echo "$FAILED skill(s) failed review. Fix the findings and commit again."
  echo "Override with: git commit --no-verify (not recommended)"
  exit 1
fi

echo ""
if [ "$PASSED" -gt 0 ]; then
  echo "$PASSED skill(s) passed review, $SKIPPED skipped."
else
  echo "No skill was actually reviewed ($SKIPPED skipped). See SETUP.md."
fi
exit 0
