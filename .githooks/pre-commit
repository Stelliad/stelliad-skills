#!/usr/bin/env bash
#
# Client-side half of the distribution boundary check, plus the model review
# of any skill you touched.
#
# The boundary rules live in scripts/validate-skills.sh, not here. This hook is
# a convenience that catches a problem before you commit it; the gate that
# actually holds is .github/workflows/validate.yml, which runs on every push
# and cannot be skipped with --no-verify.
#
# The model review (.githooks/skill-review, calling scripts/skill-review) is a
# second, optional layer on top: it reads for quality, not the boundary, and it
# does nothing at all unless SKILL_REVIEW_BACKEND is set. See SETUP.md.
#
# Enable: git config core.hooksPath .githooks

set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1

# Changes reach main through a pull request, so a commit sitting directly on
# main is almost always a slip rather than a decision. Catching it here is
# cheap: the staged changes survive `git switch -c`, so the fix is one command
# and nothing is lost.
#
# Two things are deliberately not caught. A rebase detaches HEAD, so there is
# no symbolic ref and the guard does not fire. A merge, cherry-pick or revert
# does NOT detach: HEAD stays on main, so finishing a conflicted `git pull`
# would otherwise be refused with no way forward except --no-verify. The
# in-progress marker files are the signal that this commit concludes an
# operation git already started, not a new change being authored on main.
GIT_DIR=$(git rev-parse --git-dir)
IN_PROGRESS=false
for marker in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD; do
  [ -f "$GIT_DIR/$marker" ] && IN_PROGRESS=true
done

BRANCH=$(git symbolic-ref --short -q HEAD || true)
ALLOW=$(git config --bool stelliad.allowMainCommits 2>/dev/null || echo false)
if [ "$BRANCH" = "main" ] && [ "$ALLOW" != "true" ] && [ "$IN_PROGRESS" = "false" ]; then
  echo "Refusing to commit directly on main. Changes land through a pull request."
  echo
  echo "  git switch -c your-branch-name   # staged changes come with you"
  echo "  git commit ..."
  echo "  git push -u origin your-branch-name && gh pr create"
  echo
  echo "If you really mean to commit on main:"
  echo "  git config stelliad.allowMainCommits true   # persistent, per clone"
  echo "  git commit --no-verify                      # just this once, but it also"
  echo "                                              # skips the boundary check and secrets scan"
  exit 1
fi

STAGED=()
while IFS= read -r f; do [ -n "$f" ] && STAGED+=("$f"); done \
  < <(git diff --cached --name-only --diff-filter=ACMR)

if [ "${#STAGED[@]}" -eq 0 ]; then exit 0; fi

if ! bash scripts/validate-skills.sh --from-index "${STAGED[@]}"; then
  echo
  echo "Commit blocked. --no-verify will get you past this hook, and then CI"
  echo "will catch the same thing on push, so it is cheaper to fix it here."
  exit 1
fi

if ! bash .githooks/skill-review; then
  exit 1
fi

exit 0
