#!/usr/bin/env bash
#
# Delegates to a personal .githooks/local/post-checkout, but only for an
# actual branch switch that moved HEAD.
#
# git calls this hook for file checkouts too (`git checkout -- some/file`),
# where $3 is 0, and for branch switches that land on the same commit. Neither
# changes what is in the working tree, so filtering here keeps every personal
# hook from having to rediscover the argument contract.
#
# Args: $1 previous HEAD, $2 new HEAD, $3 1 if this was a branch checkout.

set -uo pipefail

PREV="${1:-}"
NEW="${2:-}"
IS_BRANCH="${3:-0}"

[ "$IS_BRANCH" = "1" ] || exit 0
[ "$PREV" != "$NEW" ] || exit 0

exec bash "$(git rev-parse --show-toplevel)/.githooks/run-local" post-checkout "$@"
