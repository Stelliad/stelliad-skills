#!/usr/bin/env bash
#
# Runs .githooks/local/<hook-name>, if you have one, with the hook's own
# arguments. Everything under .githooks/local/ is gitignored.
#
# The split exists because core.hooksPath replaces .git/hooks wholesale: once
# this repo points git at .githooks, an untracked .git/hooks/post-commit never
# fires again, silently. So the tracked hook has to be the entry point, and
# anything personal (reinstalling a local plugin build, reloading an editor,
# poking a machine-specific daemon) has to hang off it rather than live in it.
# Nothing in .githooks/local/ ships to anyone who clones this repo.
#
# Usage, from a tracked hook:  bash .githooks/run-local post-commit "$@"

set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 0

NAME="${1:-}"
[ -n "$NAME" ] || exit 0
shift

LOCAL=".githooks/local/$NAME"
[ -x "$LOCAL" ] || exit 0

# A personal hook must never be able to fail a commit or a checkout. It runs
# after the fact, on your machine only, and the repository has no stake in
# whether it worked.
"$LOCAL" "$@" || echo "local $NAME hook exited non-zero, continuing"
exit 0
